#!/bin/sh

# Bourne Shell script that allows easy execution of the Harvest Tool
# without the need to set the CLASSPATH or having to type in that long java
# command (java gov.nasa.pds.harvest.HarvestLauncher ...)

# Expects the Harvest jar file to be in the ../lib directory.

################################################################################
# UPDATE VARIABLES AS NEEDED

SOLR_URL=http://localhost:8983/solr
SCRIPT_DIR=`cd "$( dirname $0 )" && pwd`
PARENT_DIR=`cd ${SCRIPT_DIR}/.. && pwd`
SEARCH_CONF=${PARENT_DIR}/conf/search/defaults/pds/pds4
# JAVA_HOME=

################################################################################

################################################################################
# WARNING: Should not need to update below. Proceed with caution.
################################################################################

# Check if PDS4_SOLR_DOC_HOME is set
if [ -z "${PDS4_SOLR_DOC_HOME}" ]; then
    echo "Error: PDS4_SOLR_DOC_HOME environment variable is not set"
    exit 1
fi

# Check if PDS4_SOLR_DOC_HOME directory exists
if [ ! -d "${PDS4_SOLR_DOC_HOME}" ]; then
    echo "Error: PDS4_SOLR_DOC_HOME directory does not exist: ${PDS4_SOLR_DOC_HOME}"
    exit 1
fi

# Set up logging if HARVEST_SOLR_LOG_FILE env var is set
if [ -n "${HARVEST_SOLR_LOG_FILE}" ]; then
    HARVEST_SOLR_LOG_DIR=$(dirname "${HARVEST_SOLR_LOG_FILE}")
    mkdir -p "${HARVEST_SOLR_LOG_DIR}"
    chmod 700 "${HARVEST_SOLR_LOG_DIR}"
    touch "${HARVEST_SOLR_LOG_FILE}"
    chmod 600 "${HARVEST_SOLR_LOG_FILE}"
    exec >> "${HARVEST_SOLR_LOG_FILE}" 2>&1
    echo "=== Harvest started at $(date -Iseconds) ==="
fi

# Define lock file path
LOCK_FILE="${PDS4_SOLR_DOC_HOME}/harvest-solr.lock"

# Check if lock file exists
if [ -f "$LOCK_FILE" ]; then
    echo "Error: Another instance of harvest-solr is already running."
    echo "If this is incorrect, please remove the lock file: $LOCK_FILE"
    exit 1
fi

# Create lock file
touch "$LOCK_FILE"

# Function to send email notification on exit
send_notification() {
    local exit_code=$?

    # Only send email if LEGACY_REGISTRY_EMAIL_RECIPIENTS is set
    if [ -z "${LEGACY_REGISTRY_EMAIL_RECIPIENTS}" ]; then
        return $exit_code
    fi

    # Check if mail command is available
    if ! command -v mail > /dev/null 2>&1; then
        echo "WARNING: mail command not found, skipping email notification" >&2
        return $exit_code
    fi

    local hostname_label="${HOSTNAME_LABEL:-$(hostname)}"
    local status_subject="[Harvest Solr] Succeeded on ${hostname_label}"

    if [ $exit_code -ne 0 ]; then
        status_subject="[Harvest Solr] FAILED on ${hostname_label} (Exit Code: $exit_code)"
    fi

    # Build email body
    local email_body="Harvest Solr completed.

Hostname: ${hostname_label}
Job Status: $([ $exit_code -eq 0 ] && echo "SUCCESS" || echo "FAILED (Exit Code: $exit_code)")
Timestamp: $(date -Iseconds)
"

    # Add log file location if set
    if [ -n "${HARVEST_SOLR_LOG_FILE}" ]; then
        email_body="${email_body}Log File: ${HARVEST_SOLR_LOG_FILE}
"

        # Parse harvest summary from log if available
        if [ -f "${HARVEST_SOLR_LOG_FILE}" ]; then
            local summary_text=$(tail -n 100 "${HARVEST_SOLR_LOG_FILE}" | grep -A 22 "Summary" || echo "No summary block found.")

            # Extract errors, filtering out known XML parsing warnings
            local errors_text=$(tail -n 1000 "${HARVEST_SOLR_LOG_FILE}" | \
                                grep ERROR | \
                                grep -v "line 1: Content is not allowed in prolog" | \
                                head -n 20 || \
                                echo "No errors found.")

            email_body="${email_body}
--- HARVEST SUMMARY ---
${summary_text}

--- RELEVANT LOG ERRORS (First 20) ---
${errors_text}
"
        fi
    fi

    # Send email (non-fatal - don't let mail failure change exit code)
    if echo "${email_body}" | mail -s "${status_subject}" "${LEGACY_REGISTRY_EMAIL_RECIPIENTS}"; then
        echo "Email notification sent successfully" >&2
    else
        echo "WARNING: Failed to send email notification" >&2
    fi

    return $exit_code
}

# Function to clean up lock file on exit
cleanup() {
    rm -f "$LOCK_FILE"
    echo ""
    echo "Lock file removed."
}

# Function to create marker file on exit so Registry knows to execute
marker_file() {
    # Check that the marker path is set
    if [ -z "${HARVEST_SOLR_MARKER_FILE}" ]; then
        echo "Error: HARVEST_SOLR_MARKER_FILE environment variable is not set"
        exit 1
    fi

    echo ""
    echo "Creating success marker file: $HARVEST_SOLR_MARKER_FILE"
    {
        echo "# This file signals that Harvest created new Solr docs."
        echo "# Registry looks for this file as a marker to run."
        echo "datetime=$(date -Iseconds)"
        echo "timestamp=$(date +%s)"
    } > "$HARVEST_SOLR_MARKER_FILE"
    chmod 600 "$HARVEST_SOLR_MARKER_FILE"
    echo "✓ Success marker created"
}

exit_functions() {
    local exit_code=$?
    send_notification

    # Determine if harvest succeeded
    # Check log for success indicator if exit_code is non-zero (handles OOM at teardown)
    local harvest_succeeded=false
    if [ $exit_code -eq 0 ]; then
        harvest_succeeded=true
    elif [ -n "${HARVEST_SOLR_LOG_FILE}" ] && [ -f "${HARVEST_SOLR_LOG_FILE}" ]; then
        # Check log for success indicator (0 failed docs means success despite OOM)
        if tail -n 100 "${HARVEST_SOLR_LOG_FILE}" | grep -q "0          Failed to get created"; then
            echo "INFO: Harvest succeeded based on log analysis (exit code: $exit_code)"
            harvest_succeeded=true
        else
            echo "INFO: Harvest failed - success indicator not found in log (exit code: $exit_code)"
        fi
    else
        echo "INFO: Harvest failed with exit code $exit_code (no log file to verify)"
    fi

    if [ "$harvest_succeeded" = true ]; then
        marker_file
    fi
    cleanup
}

# Set up trap to ensure lock file is removed on script exit
trap exit_functions EXIT

# Check if the JAVA_HOME environment variable is set.
if [ -z "${JAVA_HOME}" ]; then
   JAVA_CMD=`which java`
   if [ $? -ne 0 ]; then
     echo "JAVA_HOME is not set as an environment variable"
     exit 1
   fi
else
   JAVA_CMD="${JAVA_HOME}"/bin/java
fi


LIB_DIR=${PARENT_DIR}/lib
KEYSTORE=${PARENT_DIR}/keystore/tomcat_self_sign_keystore

# Check for dependencies.
if [ ! -f ${LIB_DIR}/harvest-*.jar ]; then
    echo
    echo "ERROR: Cannot find Harvest jar file in ${LIB_DIR}" 1>&2
    echo
    exit 1
fi

# Finds the jar file in LIB_DIR and sets it to HARVEST_JAR.
HARVEST_JAR=`ls ${LIB_DIR}/harvest-*.jar`

# Executes Harvest via the executable jar file
# Arguments are passed in to the tool via '$@'
${JAVA_CMD} -Xms1024m -Xmx2048m -Dcom.sun.xml.bind.v2.bytecode.ClassTailor.noOptimize=true -Dpds.search=${SOLR_URL} -Dpds.harvest.search.conf=${SEARCH_CONF} -Dresources.home=${PARENT_DIR}/resources -jar ${HARVEST_JAR} "$@"

